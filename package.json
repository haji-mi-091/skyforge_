{
  "name": "skyforge",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "SKYFORGE — a browser-based 6-DOF jet flight engine and air-combat testbed",
  "scripts": {
    "start": "node server.mjs",
    "test": "node tests/flight.test.mjs",
    "test:gear": "node tests/cad-landing-gear.test.mjs",
    "test:gear:browser": "node tools/check-doors.mjs",
    "test:airframe": "node tests/f16-airframe.test.mjs",
    "test:airframe:game": "node tools/check-f16-game.mjs",
    "test:f16:normals": "node tests/f16-normals.test.mjs",
    "test:f16:nozzle": "node tests/f16-nozzle.test.mjs",
    "test:controls": "node tests/controls.test.mjs && node tools/check-controls.mjs",
    "test:systems": "node tests/f16-systems.test.mjs",
    "build:f16:intake": "node tools/build-f16-intake.mjs",
    "test:f16:intake": "node tests/f16-intake-light.test.mjs && node tests/f16-systems.test.mjs && node tools/check-f16-intake.mjs",
    "test:exhaust": "node tools/check-f16-exhaust.mjs",
    "build:j16": "node tools/build-j16-model.mjs && node tools/build-j16-stores.mjs",
    "test:j16": "node tests/j16-model.test.mjs && node tests/j16-surfaces.test.mjs && node tests/j16-intake.test.mjs && node tests/j16-landing-gear.test.mjs && node tests/j16-tail.test.mjs && node tests/j16-wing.test.mjs && node tests/j16-engine.test.mjs && node tests/j16-stores.test.mjs && node tools/check-j16-irst.mjs",
    "test:j16:stores": "node tests/j16-stores.test.mjs && node tools/check-j16-stores.mjs",
    "test:j16:systems": "node tests/j16-engine.test.mjs && node tools/check-j16-launch-clearance.mjs && node tools/check-j16-systems.mjs",
    "check:j16:integration": "node tests/j16-integration.test.mjs && node tools/check-j16-integration.mjs",
    "check:j16:skin": "node tools/check-j16-skin.mjs",
    "test:j16:tail": "node tests/j16-tail.test.mjs && node tools/check-j16-tail.mjs",
    "test:j16:gear": "node tests/j16-landing-gear.test.mjs && node tools/check-j16-landing-gear.mjs",
    "test:j16:browser": "node tools/check-j16-model.mjs",
    "test:j16:intake": "node tests/j16-intake.test.mjs && node tools/check-j16-intake.mjs",
    "build:j10c": "node tools/build-j10c-cad-base.mjs && node tools/build-j10c-model.mjs",
    "test:j10c": "node tests/j10c-model.test.mjs",
    "test:j10c:browser": "node tools/check-j10c-model.mjs",
    "audit:j10c": "node tools/audit-j10c-airframe.mjs",
    "check:j10c:integration": "node tests/j10c-integration.test.mjs && node tools/check-j10c-integration.mjs",
    "test:systems:game": "node tools/check-f16-systems-game.mjs",
    "test:ai": "node tests/ai.test.mjs",
    "test:ai:game": "node tools/check-ai-game.mjs",
    "test:audio": "node tests/audio-combat.test.mjs",
    "test:gameplay": "node tests/gameplay-controls.test.mjs && node tools/check-gameplay-controls.mjs",
    "test:audio:game": "node tools/check-audio-game.mjs"
  }
}
